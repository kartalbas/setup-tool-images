ARG BASE=debian:trixie-20261027-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d

FROM ${BASE} AS install
ARG DEBIAN_FRONTEND=noninteractive
ARG REDIS_VERSION=8.10
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl tar gzip unzip xz-utils libatomic1 python3 \
 && rm -rf /var/lib/apt/lists/*
COPY versions.table /versions.table
RUN codename=$(. /etc/os-release && echo "$VERSION_CODENAME") \
 && mkdir /fetch /vendor-apt /vendor-apt/keys /vendor-apt/sources /vendor-apt/preferences \
 && printf 'Dir::Etc::sourceparts "/vendor-apt/sources";\nDir::Etc::preferencesparts "/vendor-apt/preferences";\n' >/vendor-apt/apt.conf \
 && repository() { \
      install --mode 0644 "$2" "/vendor-apt/keys/$1.$3" \
      && printf 'Types: deb\nURIs: %s\nSuites: %s\nComponents: main\nSigned-By: /vendor-apt/keys/%s.%s\n' "$4" "$5" "$1" "$3" >"/vendor-apt/sources/$1.sources" \
      && echo "$6" >>/vendor-apt/packages; \
    } \
 && redis_pin() { \
      [ "$1" = REDIS_VERSION ] || { echo "versions.table: a Redis row holds the marker REDIS_VERSION, not '$1'" >&2; exit 1; }; \
      [[ "$REDIS_VERSION" =~ ^[0-9]+\.[0-9]+$ ]] || { echo "Containerfile: REDIS_VERSION is '$REDIS_VERSION', not <major>.<minor>" >&2; exit 1; }; \
      printf 'Package: redis-server redis-tools\nPin: version 6:%s.*\nPin-Priority: 1001\n' "$REDIS_VERSION" >/vendor-apt/preferences/redis; \
    } \
 && while read -r name version sha256 address; do \
      if [ -z "$address" ]; then echo "${name}=${version}" >>/vendor-apt/packages; continue; fi; \
      file="/fetch/${address##*/}"; \
      curl --fail --silent --show-error --location --retry 5 --retry-all-errors --output "$file" "$address"; \
      echo "$sha256  $file" | sha256sum --check -; \
      case "$name" in \
        node) tar -xzf "$file" -C /usr/local --strip-components=1 --no-same-owner --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' ;; \
        npm) npm install --global --ignore-scripts --offline --no-update-notifier "$file" ;; \
        pnpm) mkdir /usr/local/pnpm && tar -xzf "$file" -C /usr/local/pnpm --no-same-owner && ln -s /usr/local/pnpm/pnpm /usr/local/bin/pnpm ;; \
        dart) unzip -q "$file" -d /fetch/dart && mv /fetch/dart/dart-sdk /usr/local/dart && ln -s /usr/local/dart/bin/dart /usr/local/bin/dart ;; \
        helm) tar -xzf "$file" -C /usr/local/bin --strip-components=1 --no-same-owner linux-amd64/helm ;; \
        yq) install --mode 0755 "$file" /usr/local/bin/yq ;; \
        promtool) tar -xzf "$file" -C /usr/local/bin --strip-components=1 --no-same-owner "prometheus-${version}.linux-amd64/promtool" ;; \
        gitleaks) tar -xzf "$file" -C /usr/local/bin --no-same-owner gitleaks ;; \
        powershell) mkdir -p /opt/microsoft/powershell/7 && tar -xzf "$file" -C /opt/microsoft/powershell/7 --no-same-owner && chmod 0755 /opt/microsoft/powershell/7/pwsh && ln -s /opt/microsoft/powershell/7/pwsh /usr/local/bin/pwsh ;; \
        emcc) mkdir /usr/local/emcc && tar -xJf "$file" -C /usr/local/emcc --strip-components=1 --no-same-owner \
          && emcc_release=$(tr -d '"' </usr/local/emcc/emscripten/emscripten-version.txt) \
          && { [ "${emcc_release%-git}" = "$version" ] || { echo "versions.table: the emcc archive holds Emscripten '$emcc_release', not $version" >&2; exit 1; }; } \
          && printf '"%s"\n' "$version" >/usr/local/emcc/emscripten/emscripten-version.txt \
          && printf "LLVM_ROOT = '/usr/local/emcc/bin'\nBINARYEN_ROOT = '/usr/local/emcc'\nFROZEN_CACHE = True\n" >/usr/local/emcc/emscripten/.emscripten \
          && EM_FROZEN_CACHE=0 /usr/local/emcc/emscripten/embuilder build --lto libGL-getprocaddr libal libc libc-debug libc_optz libclang_rt.builtins libdlmalloc libdlmalloc-debug libhtml5 libnoexit libsockets libstubs libstubs-debug \
          && printf '#!/bin/sh\nexec /usr/local/emcc/emscripten/emcc "$@"\n' >/usr/local/bin/emcc && chmod 0755 /usr/local/bin/emcc ;; \
        kubectl) install --mode 0755 "$file" /usr/local/bin/kubectl ;; \
        kubeconform) tar -xzf "$file" -C /usr/local/bin --no-same-owner kubeconform ;; \
        rclone) unzip -q -j "$file" "rclone-${version}-linux-amd64/rclone" -d /usr/local/bin && chmod 0755 /usr/local/bin/rclone ;; \
        mongodump) series=${address##*/server-}; repository mongodb "$file" asc https://repo.mongodb.org/apt/debian "${codename}/mongodb-org/${series%.asc}" "mongodb-database-tools=${version}" ;; \
        mongosh) series=${address##*/server-}; repository mongodb "$file" asc https://repo.mongodb.org/apt/debian "${codename}/mongodb-org/${series%.asc}" "mongodb-mongosh=${version}" ;; \
        pg_dumpall) repository postgresql "$file" asc https://apt.postgresql.org/pub/repos/apt "${codename}-pgdg" "postgresql-client-${version}" ;; \
        redis-cli) repository redis "$file" asc https://packages.redis.io/deb "$codename" redis-tools && redis_pin "$version" ;; \
        redis-server) repository redis "$file" asc https://packages.redis.io/deb "$codename" redis-server && redis_pin "$version" ;; \
        mariadb) repository mariadb "$file" gpg "https://dlm.mariadb.com/repo/mariadb-server/${version}/repo/debian" "$codename" mariadb-client ;; \
        *) echo "versions.table: no install step for $name" >&2; exit 1 ;; \
      esac; \
      rm -f "$file"; \
    done < <(grep -v -E '^(#|$)' /versions.table)

FROM ${BASE}
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      git ca-certificates curl jq openssl procps coreutils python3 openssh-client patch unzip xz-utils tar gzip libatomic1 libicu76 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=install /vendor-apt /vendor-apt
RUN cp /etc/apt/sources.list.d/debian.sources /vendor-apt/sources/ \
 && apt-get --config-file /vendor-apt/apt.conf update \
 && xargs apt-get --config-file /vendor-apt/apt.conf install --yes --no-install-recommends </vendor-apt/packages \
 && rm -rf /var/lib/apt/lists/* /vendor-apt
COPY --from=install /usr/local /usr/local
COPY --from=install /opt/microsoft /opt/microsoft
RUN groupadd --gid 1000 toolbox \
 && useradd --uid 1000 --gid 1000 --home-dir /work --no-create-home --shell /bin/bash toolbox \
 && install --directory --owner 1000 --group 1000 /work
USER 1000
WORKDIR /work
