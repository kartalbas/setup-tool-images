ARG BASE=debian:trixie-20261027-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d

FROM ${BASE} AS install
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl tar gzip unzip xz-utils libatomic1 \
 && rm -rf /var/lib/apt/lists/*
COPY versions.table /versions.table
RUN mkdir /fetch \
 && while read -r name version sha256 address; do \
      file="/fetch/${address##*/}"; \
      curl --fail --silent --show-error --location --retry 5 --retry-all-errors --output "$file" "$address"; \
      echo "$sha256  $file" | sha256sum --check -; \
      case "$name" in \
        node) tar -xzf "$file" -C /usr/local --strip-components=1 --no-same-owner --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' ;; \
        npm) npm install --global --ignore-scripts --offline "$file" ;; \
        pnpm) mkdir /usr/local/pnpm && tar -xzf "$file" -C /usr/local/pnpm --no-same-owner && ln -s /usr/local/pnpm/pnpm /usr/local/bin/pnpm ;; \
        dart) unzip -q "$file" -d /fetch/dart && mv /fetch/dart/dart-sdk /usr/local/dart && ln -s /usr/local/dart/bin/dart /usr/local/bin/dart ;; \
        helm) tar -xzf "$file" -C /usr/local/bin --strip-components=1 --no-same-owner linux-amd64/helm ;; \
        yq) install --mode 0755 "$file" /usr/local/bin/yq ;; \
        promtool) tar -xzf "$file" -C /usr/local/bin --strip-components=1 --no-same-owner "prometheus-${version}.linux-amd64/promtool" ;; \
        gitleaks) tar -xzf "$file" -C /usr/local/bin --no-same-owner gitleaks ;; \
        powershell) mkdir -p /opt/microsoft/powershell/7 && tar -xzf "$file" -C /opt/microsoft/powershell/7 --no-same-owner && chmod 0755 /opt/microsoft/powershell/7/pwsh && ln -s /opt/microsoft/powershell/7/pwsh /usr/local/bin/pwsh ;; \
        *) echo "versions.table: no install step for $name" >&2; exit 1 ;; \
      esac; \
      rm -f "$file"; \
    done < <(grep -v -E '^(#|$)' /versions.table)

FROM ${BASE}
RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      git ca-certificates curl jq openssl procps coreutils python3 openssh-client patch unzip xz-utils tar gzip libatomic1 libicu76 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=install /usr/local /usr/local
COPY --from=install /opt/microsoft /opt/microsoft
RUN groupadd --gid 1000 toolbox \
 && useradd --uid 1000 --gid 1000 --home-dir /work --no-create-home --shell /bin/bash toolbox \
 && install --directory --owner 1000 --group 1000 /work
USER 1000
WORKDIR /work
