ARG BASE=ghcr.io/kartalbas/toolbox:1.3.2@sha256:c684ddd9e8aa3847cfcba7b504587732b83522abe3f39bdac6bea6e83ddc1510

FROM ${BASE}
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
USER 0
COPY versions.table /versions.table
RUN packages=$(awk '!/^(#|$)/ { print $1 "=" $2 }' /versions.table); \
    [ -n "$packages" ] || { echo "versions.table: no row" >&2; exit 1; }; \
    apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends ${packages} \
 && rm -rf /var/lib/apt/lists/* /versions.table
ENV REPORT_CHROMIUM_PATH=/usr/bin/chromium
ENV REPORT_CHROMIUM_ARGS=--no-sandbox,--disable-dev-shm-usage
USER 1000
